# Environment files with secrets: generated by server/gen-env.sh from .env.example
.env
server/monitoring-stack/.env
server/inventory-stack/.env
.env.local
.env.*.local
.env.production
.env.secret

# Secrets and credentials
**/secrets/
**/credentials/
*.pem
*.p12
*.pfx

# TLS keys and certificates: generated per host at install time, never committed
*.key
*.crt
*.pem

# Log files
*.log
logs/
**/data/

# Docker data volumes
**/pgdata/
**/postgresql/
**/mysql-data/
**/grafana-data/
**/prometheus-data/
**/loki-data/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Evidence collection output
Evidence_*/
*.evtx
*.tar.gz
*.zip

# Windows specific
*.exe
*.msi
*.dll

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/

# Node.js (if any web tools)
node_modules/
package-lock.json

# Backup files
*.bak
*.backup
*.old

# Test output
test-results/
coverage/
