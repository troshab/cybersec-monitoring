# Line endings: shell scripts and configs must be LF (a CRLF shebang breaks bash on Linux);
# PowerShell scripts stay CRLF for Windows PowerShell 5.1 and editors on Windows.
* text=auto eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
